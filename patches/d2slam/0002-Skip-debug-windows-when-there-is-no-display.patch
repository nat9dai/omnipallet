From e42553181af934108d5564efbb2c590010fad0d4 Mon Sep 17 00:00:00 2001
From: Nuthasith Gerdpratoom <nuthasith.g@gmail.com>
Date: Tue, 20 Oct 2026 22:47:57 +0800
Subject: [PATCH 2/4] Skip debug windows when there is no display

---
 d2frontend/src/d2featuretracker.cpp | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/d2frontend/src/d2featuretracker.cpp b/d2frontend/src/d2featuretracker.cpp
index ba687ed..c38a86e 100644
--- a/d2frontend/src/d2featuretracker.cpp
+++ b/d2frontend/src/d2featuretracker.cpp
@@ -987,8 +987,8 @@ void D2FeatureTracker::drawRemote(const VisualImageDescArray &frames,
   char buf[64] = {0};
   sprintf(buf, "RemoteMatched @ Drone %d", params->self_id);
   cv::hconcat(img, img_r, img);
-  cv::imshow(buf, img);
-  cv::waitKey(1);
+  if (getenv("DISPLAY")) cv::imshow(buf, img);
+  if (getenv("DISPLAY")) cv::waitKey(1);
   if (_config.write_to_file) {
     sprintf(buf, "%s/featureTracker_remote%06d.jpg",
             _config.output_folder.c_str(), frame_count);
@@ -1001,8 +1001,8 @@ void D2FeatureTracker::draw(const VisualImageDesc &frame, bool is_keyframe,
   cv::Mat img = drawToImage(frame, is_keyframe, report);
   char buf[64] = {0};
   sprintf(buf, "featureTracker @ Drone %d", params->self_id);
-  cv::imshow(buf, img);
-  cv::waitKey(1);
+  if (getenv("DISPLAY")) cv::imshow(buf, img);
+  if (getenv("DISPLAY")) cv::waitKey(1);
   if (_config.write_to_file) {
     sprintf(buf, "%s/featureTracker%06d.jpg", _config.output_folder.c_str(),
             frame_count);
@@ -1018,8 +1018,8 @@ void D2FeatureTracker::draw(const VisualImageDesc &lframe,
   cv::hconcat(img, img_r, img);
   char buf[64] = {0};
   sprintf(buf, "featureTracker @ Drone %d", params->self_id);
-  cv::imshow(buf, img);
-  cv::waitKey(1);
+  if (getenv("DISPLAY")) cv::imshow(buf, img);
+  if (getenv("DISPLAY")) cv::waitKey(1);
   if (_config.write_to_file) {
     sprintf(buf, "%s/featureTracker%06d.jpg", _config.output_folder.c_str(),
             frame_count);
@@ -1039,8 +1039,8 @@ void D2FeatureTracker::draw(const VisualImageDescArray &frames,
 
   char buf[64] = {0};
   sprintf(buf, "featureTracker @ Drone %d", params->self_id);
-  cv::imshow(buf, img);
-  cv::waitKey(1);
+  if (getenv("DISPLAY")) cv::imshow(buf, img);
+  if (getenv("DISPLAY")) cv::waitKey(1);
   if (_config.write_to_file) {
     sprintf(buf, "%s/featureTracker%06d.jpg", _config.output_folder.c_str(),
             frame_count);
@@ -1273,9 +1273,9 @@ bool D2FeatureTracker::matchLocalFeatures(
               img_desc_a.camera_index, img_desc_a.drone_id,
               img_desc_b.camera_index, img_desc_b.drone_id);
       cv::vconcat(show, show_check, show);
-      cv::imshow(name, show);
+      if (getenv("DISPLAY")) cv::imshow(name, show);
     } else {
-      cv::imshow(name, show);
+      if (getenv("DISPLAY")) cv::imshow(name, show);
     }
   }
 
