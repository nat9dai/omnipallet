     for (unsigned int i = 0; i < cur_lk_info.lk_pts.size(); i++) {
       auto ret =
           createLKLandmark(right_frame, cur_lk_info.lk_pts[i],
@@ -736,17 +756,30 @@ TrackReport D2FeatureTracker::trackLK(const VisualImageDesc &left_frame,
       if (!ret.first) {
         continue;
       }
+      n_created++;
+      auto pred = pts_pred_a_on_b.at(cur_lk_info.lk_ids[i]);
+      double disparity = cv::norm(pred - cur_lk_info.lk_pts[i]);
+      pred_err += disparity;
+      // a far point across a short baseline gets a depth from noise alone, and that depth is biased short
+      if (disparity < _config.cross_cam_min_disparity) {
+        continue;
