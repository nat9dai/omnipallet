+    if (frames.frame_id % 25 == 0) {
+      // landmarks seen by two neighbouring cameras in this frame: these carry the metric baseline
+      int shared[4] = {0, 0, 0, 0};
+      for (int c = 0; c < 4; c++) {
+        std::set<LandmarkIdType> ids;
+        for (auto &lm : frames.images[c].landmarks) ids.insert(lm.landmark_id);
+        for (auto &lm : frames.images[(c + 1) % 4].landmarks)
+          if (lm.landmark_id >= 0 && ids.count(lm.landmark_id)) shared[c]++;
+      }
+      SPDLOG_INFO("[Track] frame {} landmarks {} shared 01 {} 12 {} 23 {} 30 {}", frames.frame_id,
+                  frames.landmarkNum(), shared[0], shared[1], shared[2], shared[3]);
+    }
   }
   if (isKeyframe(report) && frames.send_to_backend) {
     iskeyframe = true;
@@ -727,8 +739,16 @@ TrackReport D2FeatureTracker::trackLK(const VisualImageDesc &left_frame,
