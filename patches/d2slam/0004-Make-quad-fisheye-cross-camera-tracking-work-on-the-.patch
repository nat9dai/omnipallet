+          disparity < _config.search_local_max_dist_lr * image_width) {
         right_frame.landmarks.emplace_back(lm);
+        n_kept++;
       }
     }
+    if (left_frame.frame_id % 25 == 0) {
+      SPDLOG_DEBUG("[TrackLR] cam {}->{} type {} left {} flow {} created {} kept {} mean pred err {:.1f}px (gate {:.1f})",
