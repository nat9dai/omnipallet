<?xml version="1.0"?>
<package format="3">
  <name>stock_drone</name>
  <version>0.1.0</version>
  <description>Warehouse stock-counting quadrotor: offboard mission, VIO bridge to PX4, barcode scanning and inventory.</description>
  <maintainer email="nuthasith.g@gmail.com">Nuthasith Gerdpratoom</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
